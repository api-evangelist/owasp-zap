                },
                {
                  "disabled": false,
                  "key": "initiators",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<string>",
                  "description": "A regular expression to match the URL of the message, if empty the rule applies to all messages."
