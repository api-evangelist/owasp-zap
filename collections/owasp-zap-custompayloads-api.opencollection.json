              {
                "name": "payload",
                "value": "",
                "type": "query",
                "description": "The payload being enabled."
              }
            ]
          },
          "docs": "Enables a given payload."
        },
        {
          "info": {
            "name": "custompayloadsActionEnableCustomPayloads",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://zap/JSON/custompayloads/action/enableCustomPayloads/",
