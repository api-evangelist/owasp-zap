                "description": "The Context ID"
              },
              {
                "name": "userId",
                "value": "",
                "type": "query",
                "description": "The User ID"
              }
            ]
          },
          "docs": "Removes the user with the given ID that belongs to the context with the given ID."
        },
        {
          "info": {
            "name": "usersActionSetAuthenticationCredentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://zap/JSON/users/action/setAuthenticationCredentials/",
