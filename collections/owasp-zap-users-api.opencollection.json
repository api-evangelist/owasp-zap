              {
                "name": "authCredentialsConfigParams",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Sets the authentication credentials for the user with the given ID that belongs to the context with the given ID."
        },
        {
          "info": {
            "name": "usersActionSetAuthenticationState",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://zap/JSON/users/action/setAuthenticationState/",
            "params": [
              {
                "name": "contextId",
                "value": "",
                "type": "query",
                "description": "The Context ID"
              },
              {
                "name": "userId",
                "value": "",
                "type": "query",
                "description": "The User ID"
              },
              {
                "name": "lastPollResult",
                "value": "",
                "type": "query",
                "description": "Last Poll Result - optional, should be 'true' or 'false'."
              },
              {
                "name": "lastPollTimeInMs",
                "value": "",
                "type": "query",
                "description": "Last Poll Time in Milliseconds - optional, should be a long or 'NOW' for the current time in ms."
