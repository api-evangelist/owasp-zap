              {
                "name": "requestsSinceLastPoll",
                "value": "",
                "type": "query",
                "description": "Requests Since Last Poll - optional, should be an integer."
              }
            ]
          },
          "docs": "Sets fields in the authentication state for the user identified by the Context and User Ids."
        },
        {
          "info": {
            "name": "usersActionSetCookie",
