          "name": "access Control Action Scan",
          "request": {
            "name": "access Control Action Scan",
            "description": {
              "content": "Starts an Access Control scan with the given context ID and user ID. (Optional parameters: user ID for Unauthenticated user, boolean identifying whether or not Alerts are raised, and the Risk level for the Alerts.) [This assumes the Access Control rules were previously established via ZAP gui and the necessary Context exported/imported.]",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "JSON",
                "accessControl",
                "action",
                "scan",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
