          "name": "authorization Action Set Basic Authorization Detection Method",
          "request": {
            "name": "authorization Action Set Basic Authorization Detection Method",
            "description": {
              "content": "Sets the authorization detection method for a context as one that identifies un-authorized messages based on: the message's status code or a regex pattern in the response's header or body. Also, whether all conditions must match or just some can be specified via the logicalOperator parameter, which accepts two values: \"AND\" (default), \"OR\".  ",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "JSON",
